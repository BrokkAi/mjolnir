#!/usr/bin/expect -f

set timeout 90
set stty_init "rows 40 columns 120"
set mode $env(MJ_E2E_MODE)
set transcript $env(MJ_E2E_TRANSCRIPT)
set inline_mode [expr {$mode eq "inline-stream" || $mode eq "details" || $mode eq "parallel"}]
log_file -noappend $transcript

proc send_ctrl_c {} {
    global spawn_id
    send -i $spawn_id -- "\003"
}

# Ctrl-C means "cancel" while a turn is in flight and "quit" only on an idle,
# empty prompt. A turn that used a subagent and changed the workspace is still
# held by the discrete review after its text has streamed, so the first Ctrl-C
# can land on a live turn. Keep nudging until the process actually exits.
proc quit_mj {} {
    global timeout
    set previous_timeout $timeout
    set timeout 8
    for {set attempt 0} {$attempt < 4} {incr attempt} {
        # The process can exit at any point in this dance, and eof may even
        # have been consumed by an earlier case-branch expect (a pattern can
        # match residual buffer in the same read that hits eof). A closed
        # spawn id makes both expect and send raise hard Tcl errors, so treat
        # any such error as "the process is gone", which is the goal state.
        if {[catch {expect {
            eof {
                set timeout $previous_timeout
                return
            }
            timeout { catch { send_ctrl_c } }
        }}]} {
            set timeout $previous_timeout
            return
        }
    }
    set timeout $previous_timeout
    if {[catch {expect {
        eof {}
        timeout { exit 44 }
    }}]} {
        return
    }
}

set command [list $env(MJ_E2E_BIN) --no-update-check --debug-file $env(MJ_E2E_DEBUG_LOG) --agent-stderr $env(MJ_E2E_AGENT_STDERR)]
if {!$inline_mode} {
    lappend command --fullscreen-tui
}
lappend command --cwd $env(MJ_E2E_WORKSPACE)
spawn {*}$command
if {$inline_mode} {
    expect_before -re {\x1b\[6n} {
        send -- "\x1b\[1;1R"
        exp_continue
    }
}

if {$mode eq "unsupported"} {
    # Codex capabilities are synthesized from credentials at roster time, so
    # an adapter that turns out not to advertise HTTP MCP fails at session
    # launch with a fatal + hint rather than being excluded from the roster.
    expect {
        -re {does not support HTTP MCP} {}
        timeout { exit 18 }
    }
    exit 0
}

# The roster banner is the only textual startup signal; there is no
# "connected" message anymore. A prompt sent while the session is still
# starting is staged and auto-submitted once the session is ready.
expect {
    -nocase -re {Agents.*primary} {}
    timeout { exit 36 }
}

set user_prompt "write a hello world program in Python"
if {$mode eq "details"} {
    set user_prompt "USER_LONG_PREFIX [string repeat u 720] USER_LONG_SUFFIX"
}
after 300
send -- "$user_prompt\r"

if {$mode eq "parallel"} {
    expect {
        -re {subagent permission} { send -- "\r"; exp_continue }
        -re {PRIMARY.*RECEIVED} { after 1500; send_ctrl_c }
        timeout { exit 39 }
    }
} elseif {$mode eq "inline-stream"} {
    expect {
        -re {fixture reasoning} {
            # No ordering check against MJ_E2E_PRIMARY_RESULT here: with the
            # push model, create_subagent acks within milliseconds -- faster
            # than a redraw frame -- so the result file existing first proves
            # nothing about streaming liveness. Seeing the thought text at all
            # is the streaming assertion.
            send_ctrl_c
        }
        timeout { exit 26 }
    }
    expect {
        -re {Enter send} { after 500; send_ctrl_c }
        timeout { exit 27 }
    }
} elseif {$mode eq "cancel"} {
    # The primary cancels its own subagent via the subagent_cancel tool; the
    # driver only needs to wait for its confirmation before quitting.
    expect {
        -re {PRIMARY.*CANCELLED.*SUBAGENT} { after 500; send_ctrl_c }
        timeout { exit 20 }
    }
} elseif {$mode eq "failed"} {
    expect {
        -re {PRIMARY.*RECEIVED} { after 500; send_ctrl_c }
        timeout { exit 38 }
    }
} elseif {$mode eq "no-change"} {
    expect {
        -re {PRIMARY.*NO.*CHANGE} { after 500; send_ctrl_c }
        timeout { exit 35 }
    }
} elseif {$mode eq "terminal-output"} {
    expect {
        -re {SAFE_TERMINAL_TAIL} {}
        timeout { exit 45 }
    }
    expect {
        -re {TERMINAL_E2E_DONE} { after 500; send_ctrl_c }
        timeout { exit 46 }
    }
} elseif {$mode eq "details"} {
    expect {
        -re {details hidden} {}
        timeout { exit 28 }
    }
    for {set handoff 0} {$handoff < 2} {incr handoff} {
        expect {
            -re {subagent permission} { send -- "\r" }
            timeout { exit 29 }
        }
    }
    expect {
        -re {discrete review brief} {}
        timeout { exit 30 }
    }
    expect {
        -re {Enter.*send} { after 500; send -- "\024" }
        timeout { exit 31 }
    }
    expect {
        -re {PRIMARY_LONG_SUFFIX} { send -- "\033\[H" }
        timeout { exit 32 }
    }
    set user_seen 0
    set delegation_seen 0
    while {!$user_seen || !$delegation_seen} {
        expect {
            -re {USER_LONG_SUFFIX} { set user_seen 1 }
            -re {DELEGATION_LONG_SUFFIX} { set delegation_seen 1 }
            timeout { exit 33 }
        }
    }
    set previous_timeout $timeout
    set timeout 2
    set subagent_seen 0
    for {set page 0} {$page < 12 && !$subagent_seen} {incr page} {
        send -- "\033\[6~"
        expect {
            -re {SUBAGENT_LONG_SUFFIX} { set subagent_seen 1 }
            timeout {}
        }
    }
    set timeout $previous_timeout
    if {!$subagent_seen} { exit 34 }
    send -- "\024"
    after 500
    send_ctrl_c
} elseif {$mode eq "complete"} {
    expect {
        -re {subagent permission} { send -- "\r"; exp_continue }
        -re {PRIMARY.*RECEIVED.*SUBAGENT_E2E_OK} { after 500; send_ctrl_c }
        timeout { exit 43 }
    }
} else {
    # The corrective turn's answer is the compact turn's final response and
    # renders at the bottom of the transcript when it streams.
    expect {
        -re {subagent permission} { send -- "\r"; exp_continue }
        -re {PRIMARY.*FINAL.*REVIEWED} { after 500; send_ctrl_c }
        timeout { exit 23 }
    }
}
quit_mj
