#!/usr/bin/expect -f

set timeout 600
set stty_init "rows 40 columns 120"
log_file -noappend $env(MJ_E2E_TRANSCRIPT)
spawn $env(MJ_E2E_BIN) --no-update-check --fullscreen-tui --debug-file $env(MJ_E2E_DEBUG_LOG) --agent-stderr $env(MJ_E2E_AGENT_STDERR) --cwd $env(MJ_E2E_WORKSPACE)
expect_before -re {\x1b\[6n} {
    send -- "\x1b\[1;1R"
    exp_continue
}
expect {
    -re {Agents.*primary} {}
    timeout { exit 29 }
}
after 300
send -- "$env(MJ_E2E_LIVE_PROMPT)\r"

expect {
    -re {permission request} { send -- "\r"; exp_continue }
    -re {subagent.*gpt} {}
    timeout { exit 30 }
}

expect {
    -re {permission request} { send -- "\r"; exp_continue }
    -re "$env(MJ_E2E_LIVE_TOKEN)" {}
    timeout { exit 32 }
}
# Quit: ratatui repaints only changed cells, so no fixed screen text is
# guaranteed to reappear after the token match. Nudge Ctrl-C until the
# process exits (the first one may only cancel a review-held turn), and
# tolerate a spawn id that closes between nudges.
set timeout 8
for {set attempt 0} {$attempt < 5} {incr attempt} {
    after 1000
    if {[catch { send -- "\003" }]} { exit 0 }
    if {[catch {expect {
        eof { exit 0 }
        timeout {}
    }}]} {
        exit 0
    }
}
exit 33
