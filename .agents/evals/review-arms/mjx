#!/bin/bash
# Runs the installed mj with a clean environment, so the daemon does not inherit
# this session's CODEX_HOME, CLAUDE_CONFIG_DIR, MJ_SESSION_ID, MJ_CONFIG_DIR,
# MJ_DATA_DIR or tool-cache variables. By default it reaches the default (main)
# instance, where runs have happened since 2026-11-16 (brief/PLAN-writer-terra.md);
# REVIEW_ARMS_INSTANCE=private reaches the earlier private instance under
# $REVIEW_ARMS_DIR/instance instead.
B="${REVIEW_ARMS_DIR:-/mnt/optane/review-arms-20261113}/instance"
dirs=()
case "${REVIEW_ARMS_INSTANCE:-default}" in
  default) ;;
  private) dirs=(MJ_CONFIG_DIR="$B/config" MJ_DATA_DIR="$B/data") ;;
  *) echo "mjx: REVIEW_ARMS_INSTANCE must be default or private" >&2; exit 2 ;;
esac
exec env -i HOME="$HOME" USER="${USER:-jonathan}" LOGNAME="${LOGNAME:-jonathan}" \
  LANG="${LANG:-C.UTF-8}" SHELL=/bin/bash TERM=dumb \
  PATH="/home/jonathan/.cargo/bin:/home/jonathan/.local/bin:/home/jonathan/.nvm/versions/node/v24.15.0/bin:/usr/local/bin:/usr/bin:/bin" \
  XDG_RUNTIME_DIR="/run/user/$(id -u)" \
  "${dirs[@]}" \
  /home/jonathan/.cargo/bin/mj "$@"
