ARG NODE_IMAGE=docker.io/library/node:24-trixie
# Pinned to the same compiler as rust-toolchain.toml. A floating `rust:1`
# tag would drift away from the pin, and rustup would then download the
# pinned toolchain on the first cargo run without the musl target and
# components this image adds below. Bump both together.
ARG RUST_IMAGE=docker.io/library/rust:1.96.0-trixie
# Bifrost is the semantic-analysis tool every turn review depends on: the
# review's `analyze_diff` pre-pass and the analyzer/navigation MCP servers the
# reviewing agents call are both this one binary. Baking a pinned crates.io
# release into the image means a review never fetches anything at review time,
# and the version moves only when someone edits this line. Bifrost pins a newer
# compiler than Hel does (its rust-toolchain.toml names 1.97.1), so it is built
# in its own stage and only the binary is copied out.
ARG BIFROST_VERSION=0.10.7
ARG BIFROST_BUILDER_IMAGE=docker.io/library/rust:1.97.1-trixie

FROM ${NODE_IMAGE} AS node

FROM ${BIFROST_BUILDER_IMAGE} AS bifrost
ARG BIFROST_VERSION
RUN cargo install brokk-bifrost@${BIFROST_VERSION} --locked --bin bifrost --root /opt/bifrost \
    && /opt/bifrost/bin/bifrost --version

FROM ${RUST_IMAGE}

# The Node image and Rust image share the Trixie base. Copying /usr/local
# brings in Node, npm, npx, Corepack, and the headers needed by native modules.
COPY --from=node /usr/local/ /usr/local/

# Profiling tools ship in this layer: `linux-perf` is Debian's `perf` build for
# the packaged kernel, and `heaptrack` is small enough here (it only pulls
# libunwind and three Boost runtime libraries) to be worth baking in. `perf` inside a rootless container still depends on the *host*
# kernel: it needs `kernel.perf_event_paranoid` <= 1 or the container to be run
# with `--cap-add SYS_ADMIN`. That is a host setting; nothing in this image can
# or should change it. `lcov` comes along for `genhtml`, which renders the lcov
# file the coverage workflow produces; on Debian it only pulls a handful of
# small pure-Perl modules.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        fd-find \
        file \
        git \
        gh \
        heaptrack \
        jq \
        lcov \
        less \
        libssl-dev \
        linux-perf \
        musl-tools \
        openjdk-25-jdk-headless \
        openssh-client \
        patch \
        pkg-config \
        procps \
        python3 \
        python3-pip \
        python3-venv \
        ripgrep \
        sudo \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Keep these in lockstep with bridge_launch() in src/hel_controller/worker_binary.rs. Kimi is
# intentionally left to Hel's official on-demand installer because that path is
# not version-pinned yet.
RUN npm install --global --no-audit --no-fund \
        @agentclientprotocol/codex-acp@1.8.0 \
        @agentclientprotocol/claude-agent-acp@0.73.0 \
        @deepseek-ai/dsh@0.1.1-rc.2 \
        dsh-acp-server@0.10.0 \
        @openai/codex@0.151.0 \
    && npm cache clean --force \
    && codex --version \
    && codex-acp --version

# codex-acp 1.8.0 depends on @openai/codex ^0.152.0 and bundles that build, but
# 0.152 is suspected buggy, and no codex-acp release resolves to 0.151. The
# bridge's startAcpServer() prefers $CODEX_PATH over its bundled binary, so the
# separate global @openai/codex@0.151.0 above plus this variable pin the CLI
# without pinning the bridge backwards. The path is the literal target of the
# `codex` bin symlink npm creates; re-check it with `readlink -f $(which codex)`
# whenever the codex version moves. Hel layers the bridge spec's environment on
# top of the inherited process environment rather than starting from an
# allowlist, so a container ENV reaches the bridge.
ENV CODEX_PATH=/usr/local/lib/node_modules/@openai/codex/bin/codex.js

# Buildx sets TARGETARCH per platform; the dpkg fallback keeps a plain
# single-arch `podman build` working.
ARG TARGETARCH
ARG CARGO_NEXTEST_VERSION=0.9.143
RUN ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" \
    && case "$ARCH" in \
        amd64) \
            MUSL=x86_64-unknown-linux-musl; \
            NEXTEST_SHA256=6d891c18105ec2d33f6e441a4f92b7ccab47ba263e22055c8bb66884243f3389 \
            ;; \
        arm64) \
            MUSL=aarch64-unknown-linux-musl; \
            NEXTEST_SHA256=0560ce0ce017f368c54b5db86588370fc03b470985490fa81200e62a657dda05 \
            ;; \
        *) echo "unsupported arch $ARCH" >&2; exit 1 ;; \
    esac \
    && rustup component add clippy rustfmt llvm-tools-preview \
    && rustup target add "$MUSL" \
    && NEXTEST_ARCHIVE="cargo-nextest-${CARGO_NEXTEST_VERSION}-${MUSL}.tar.gz" \
    && NEXTEST_URL="https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-${CARGO_NEXTEST_VERSION}/${NEXTEST_ARCHIVE}" \
    && curl --fail --location --silent --show-error "$NEXTEST_URL" --output /tmp/cargo-nextest.tar.gz \
    && echo "$NEXTEST_SHA256  /tmp/cargo-nextest.tar.gz" | sha256sum --check --strict \
    && tar -xzf /tmp/cargo-nextest.tar.gz -C /usr/local/cargo/bin cargo-nextest \
    && rm /tmp/cargo-nextest.tar.gz \
    && install -d /usr/share/doc/cargo-nextest \
    && curl --fail --location --silent --show-error \
        "https://raw.githubusercontent.com/nextest-rs/nextest/cargo-nextest-${CARGO_NEXTEST_VERSION}/LICENSE-APACHE" \
        --output /usr/share/doc/cargo-nextest/LICENSE-APACHE \
    && curl --fail --location --silent --show-error \
        "https://raw.githubusercontent.com/nextest-rs/nextest/cargo-nextest-${CARGO_NEXTEST_VERSION}/LICENSE-MIT" \
        --output /usr/share/doc/cargo-nextest/LICENSE-MIT \
    && echo "a60eea817514531668d7e00765731449fe14d059d3249e0bc93b36de45f759f2  /usr/share/doc/cargo-nextest/LICENSE-APACHE" | sha256sum --check --strict \
    && echo "79e1e84378f5cbb0fd3f7314e80d0a02cbb8454247cecee3326c512ed7234797  /usr/share/doc/cargo-nextest/LICENSE-MIT" | sha256sum --check --strict \
    && cargo nextest --version \
    && java --version \
    && javac --version

# Playwright's Chromium needs a long list of X11, GTK and font shared libraries
# that this base image does not carry, and the unprivileged `hel` user cannot
# apt-get them at run time. `playwright install-deps` is the vendor's own,
# distro-aware mapping of that list, so it is preferred over a hand-copied apt
# package list that would silently rot as Playwright's requirements move. It is
# pinned to the exact version tests/e2e/web/package.json depends on; bump both
# together. Note that install-deps needs apt lists, which the layer above
# deletes, so this layer refreshes and re-deletes them.
#
# A browser is baked in too, so a test run needs no network access, but only the
# headless shell (`--only-shell`): tests/e2e/web/playwright.config.js runs
# `headless: true`, and Playwright 1.62 resolves that to the shell, so the far
# larger full Chromium build would never be launched. It lives in a shared
# PLAYWRIGHT_BROWSERS_PATH readable by every user rather than in root's or hel's
# home cache. An image that needs headed Chromium must add `install chromium`.
ARG PLAYWRIGHT_VERSION=1.62.1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update \
    && npx --yes playwright@${PLAYWRIGHT_VERSION} install-deps chromium \
    && npx --yes playwright@${PLAYWRIGHT_VERSION} install --only-shell chromium \
    && chmod -R a+rX "$PLAYWRIGHT_BROWSERS_PATH" \
    && rm -rf /var/lib/apt/lists/* /root/.npm

# Rust profiling and coverage front ends. `cargo install --locked` at pinned
# versions matches how the rest of this image treats tooling: the version moves
# only when someone edits these lines. The registry and build caches are dropped
# afterwards because nothing at run time reads them.
ARG FLAMEGRAPH_VERSION=0.6.14
ARG SAMPLY_VERSION=0.13.1
# Mirrors the pin in .github/workflows/coverage.yml; bump both together so a
# session measures coverage the same way the gate does.
ARG CARGO_LLVM_COV_VERSION=0.8.7
RUN cargo install --locked flamegraph@${FLAMEGRAPH_VERSION} \
    && cargo install --locked samply@${SAMPLY_VERSION} \
    && cargo install --locked cargo-llvm-cov --version ${CARGO_LLVM_COV_VERSION} \
    && rm -rf "${CARGO_HOME:-/usr/local/cargo}/registry" \
    && perf --version \
    && cargo flamegraph --version \
    && samply --version \
    && cargo llvm-cov --version \
    && genhtml --version

# The turn-review feature requires this binary; a review whose worker cannot
# run it fails loudly and names an image rebuild as the fix.
COPY --from=bifrost /opt/bifrost/bin/bifrost /usr/local/bin/bifrost

# Debian's /etc/profile overwrites PATH, so a login shell drops the Rust image's
# cargo bin directory and everything installed into it (cargo itself,
# cargo-nextest, and now cargo-flamegraph, samply, and cargo-llvm-cov).
# Agent-requested shell commands run through `bash -lc`, so without this they
# cannot see those tools.
RUN printf '%s\n' \
        'case ":${PATH}:" in' \
        '  *:/usr/local/cargo/bin:*) ;;' \
        '  *) PATH="/usr/local/cargo/bin:${PATH}" ;;' \
        'esac' \
        'export PATH' \
        > /etc/profile.d/10-cargo-path.sh \
    && bash -lc 'command -v cargo && command -v samply'

RUN useradd --create-home --shell /bin/bash hel \
    && mkdir -p /workspace /var/lib/hel \
    && chown -R hel:hel /workspace /var/lib/hel \
    && chmod 0755 /workspace /var/lib/hel

USER hel
ENV HOME=/home/hel \
    SHELL=/bin/bash
WORKDIR /workspace

# Metadata comes last so that editing it never invalidates the cached layers
# above; a label-only change then republishes an image whose filesystem layers
# every host already has.
LABEL org.opencontainers.image.title="Mjolnir agent development environment" \
      org.opencontainers.image.source="https://github.com/BrokkAi/mjolnir" \
      org.opencontainers.image.description="Mjolnir agent development environment with Node, Rust, cargo-nextest, OpenJDK, and the pinned ACP bridges"

# Hel overrides the command with the same keepalive, but retaining it here also
# makes the image convenient to inspect directly.
STOPSIGNAL SIGKILL
CMD ["sleep", "infinity"]
